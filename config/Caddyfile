{
 admin off
 persist_config off
 auto_https off
}
http://:5188 {
 bind 127.0.0.1
 route {
  @foreign {
   header Origin *
   not header Origin {$UPA_PUBLIC_ORIGIN}
  }
  respond @foreign "Forbidden origin" 403
  @login path /_access/login /_access/logout
  handle @login {
   reverse_proxy 127.0.0.1:5189
  }
  forward_auth 127.0.0.1:5189 {
   uri /_access/verify
   header_up -Connection
   header_up -Upgrade
  }
  header {
   Cache-Control "no-store"
   X-Content-Type-Options "nosniff"
   Referrer-Policy "same-origin"
   X-Frame-Options "DENY"
  }
  handle /api/* {
   reverse_proxy 127.0.0.1:9010 {
    header_up Host 127.0.0.1:9010
    header_up Origin http://127.0.0.1:5180
    header_up -Authorization
    header_up -X-Forwarded-Host
    flush_interval -1
   }
  }
  handle {
   root * {$UPA_WEB_ROOT}
   try_files {path} /index.html
   file_server
  }
 }
}
