# Server-only OpenAI-compatible Chat Completions settings.
# Copy to .env in this directory. Never use a VITE_ prefix for credentials.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_MAX_TOKENS=2048
# 1 uses HTTP(S)_PROXY/NO_PROXY; 0 connects directly for this client only.
MODEL_TRUST_ENV=1

# Ports are process environment variables, not model .env settings:
# BACKEND_PORT=9010 WEB_PORT=5180 ./scripts/dev.sh
