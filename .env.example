# Server-only OpenAI-compatible Chat Completions settings.
# Copy to .env in this directory. Never use a VITE_ prefix for credentials.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_MAX_TOKENS=2048
# 1 uses HTTP(S)_PROXY/NO_PROXY; 0 connects directly for this client only.
MODEL_TRUST_ENV=1

# Ports are process environment variables, not model .env settings:
# BACKEND_PORT=9010 WEB_PORT=5180 ./scripts/dev.sh

# Telephone calls are opt-in; separate from the main chat model.
CALLS_ENABLED=0
CLAWOPS_ACCOUNT_ID=
CLAWOPS_API_KEY=
CLAWOPS_FROM_NUMBER=
CALL_REALTIME_BASE_URL=
CALL_REALTIME_API_KEY=
CALL_REALTIME_MODEL=gpt-realtime-2.1
# Live uses the SAME Azure resource URL and key above, with /openai/v1/live/sessions.
CALL_AUDIO_MODE=live
CALL_LIVE_MODEL=gpt-live-1
CALL_LIVE_VOICE=marin
CALL_ALLOWED_NUMBERS=
CALL_MAX_SECONDS=180
